{
  "name": "personal-assistant-agent",
  "main": "agent-worker.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "secrets": {
    "required": ["AGENT_WORKER_TOKEN", "NEON_AI_GATEWAY_BASE_URL", "NEON_AI_GATEWAY_TOKEN", "TELEGRAM_BOT_TOKEN"]
  },
  "workflows": [
    { "name": "hello-world", "binding": "HELLO_WORLD", "class_name": "HelloWorld" },
    { "name": "ai-test", "binding": "AI_TEST", "class_name": "AiTest" },
    { "name": "telegram-reply", "binding": "TELEGRAM_REPLY", "class_name": "TelegramReplyWorkflow" }
  ]
}
